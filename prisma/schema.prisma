// PR Language Prep — CELPIP + TCF Canada practice data.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

/// One sitting of one skill (or one task within a skill).
model Attempt {
  id   String @id @default(cuid())
  /// "celpip" | "tcf"
  exam String
  /// "listening" | "reading" | "writing" | "speaking"
  skill String
  /// Task identifier within the skill, e.g. "writing-task-1". Null for a whole-skill test.
  task String?

  /// Raw score earned, in the units of the skill (MCQs correct, or a rubric score).
  score Float?
  /// Maximum the raw score could have been, so `score` stays interpretable later.
  maxScore Float?
  /// Band this maps to: "CLB 10" for CELPIP, "NCLC 7" for TCF. AI/heuristic estimate, not official.
  estimatedLevel String?

  /// Seconds the attempt actually took, for pacing against the real exam limits.
  durationSeconds Int?

  createdAt DateTime @default(now())

  responses Response[]

  @@index([exam, skill, createdAt])
}

/// What was produced during an attempt: written text, a speech transcript, or picked answers.
model Response {
  id        String  @id @default(cuid())
  attemptId String
  attempt   Attempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  /// Question/task this answers, e.g. a question id from the content JSON. Null for a single free-form task.
  questionId String?
  /// The written answer or the speech-to-text transcript.
  text String?
  /// Object URL or file path of the kept speaking recording.
  audioPath String?

  /// AI feedback as JSON: rubric scores, strengths, corrected version, fixes.
  feedback Json?

  createdAt DateTime @default(now())

  @@index([attemptId])
}

/// Per-track study settings for the daily plan.
model StudySettings {
  /// "celpip" | "tcf"
  exam         String    @id
  /// Booked (or planned) test date, if any.
  examDate     DateTime?
  /// Minutes per day the learner wants to study.
  dailyMinutes Int       @default(45)
  /// IANA time zone for "today" in the plan, e.g. "America/Toronto". Null: the server's zone.
  timeZone     String?
  updatedAt    DateTime  @updatedAt
}

/// Self-test state for one phrase-bank entry.
model PhraseReview {
  id        String   @id @default(cuid())
  /// "celpip" | "tcf"
  exam      String
  /// Stable key of the phrase: "<categoryId>:<index>".
  phraseKey String
  /// The learner marked it as known in the last self-test.
  known     Boolean
  reviews   Int      @default(1)
  updatedAt DateTime @updatedAt

  @@unique([exam, phraseKey])
}

/// A full mock exam: the four skills in exam order, one set each.
model MockExam {
  id          String    @id @default(cuid())
  /// "celpip" | "tcf"
  exam        String
  /// Ordered steps: [{ skill, setId }]. A step is done when an attempt at that
  /// set is saved after startedAt; completion is derived, never stored.
  steps     Json
  startedAt DateTime @default(now())

  @@index([exam, startedAt])
}

/// A practice set stored in the database: written by the AI, or added by the learner.
model GeneratedSet {
  id        String   @id @default(cuid())
  /// "ai" (generated) | "user" (a paper the learner added: reading or listening)
  source    String   @default("ai")
  /// "celpip" | "tcf"
  exam      String
  /// "writing" | "speaking" | "reading" | "listening"
  skill     String
  title     String
  /// The full WritingSet / SpeakingSet / TestSet JSON, validated before saving.
  data      Json
  createdAt DateTime @default(now())

  @@index([exam, skill, createdAt])
  @@index([exam, source, createdAt])
}

/// A phrase the learner saved from AI feedback, practised with the phrase bank's self-test.
model SavedPhrase {
  id        String   @id @default(cuid())
  /// "celpip" | "tcf"
  exam      String
  /// The better wording to learn (a fix's "after").
  phrase    String
  /// Why it's better, from the fix.
  note      String
  /// What the learner wrote or said instead (a fix's "before").
  before    String?
  /// "writing" | "speaking"
  source    String
  /// Last self-test result; null until tested.
  known     Boolean?
  reviews   Int      @default(0)
  createdAt DateTime @default(now())

  @@unique([exam, phrase])
  @@index([exam, createdAt])
}

/// Retry state for one reading/listening question the learner got wrong.
/// A mistake counts as learned after two correct retries in a row.
model MistakeReview {
  id         String   @id @default(cuid())
  /// "celpip" | "tcf"
  exam       String
  /// Practice set the question belongs to (Attempt.task).
  setId      String
  questionId String
  /// Correct retries in a row; a wrong retry resets it to 0.
  streak     Int      @default(0)
  retries    Int      @default(0)
  updatedAt  DateTime @updatedAt

  @@unique([exam, setId, questionId])
}

/// French course: one generated lesson, cached forever (id "u07-a").
model CourseLesson {
  /// "<unitId>-<a|b>"
  id        String   @id
  unitId    String
  /// CEFR level of the unit: "A1" | "A2" | "B1" | "B2"
  level     String
  /// "generating" while the AI writes it (claim for that request), then "ready".
  status    String   @default("generating")
  /// The validated lesson JSON (LessonSchema). Null while generating.
  data      Json?
  /// Model that wrote it, e.g. "gemini-3.8-flash".
  model     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  attempts LessonAttempt[]

  @@index([unitId])
}

/// One time through a lesson: exercise answers, the mini task and its feedback.
model LessonAttempt {
  id           String       @id @default(cuid())
  lessonId     String
  lesson       CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  startedAt    DateTime     @default(now())
  /// Set when the summary is reached.
  completedAt  DateTime?
  /// Exercises answered right on the first try, out of `total`.
  correct      Int          @default(0)
  total        Int          @default(0)
  /// Per exercise: { index, answer, correct }.
  answers      Json?
  /// "writing" | "speaking"; null when the task was skipped.
  taskKind     String?
  taskText     String?
  /// TCF 0–20 estimate from the AI.
  taskScore    Int?
  /// TaskFeedbackSchema JSON.
  taskFeedback Json?

  @@index([lessonId, startedAt])
}

/// French course placement: one AI-written question, cached and reused across retakes.
model PlacementQuestion {
  id        String   @id @default(cuid())
  /// CEFR level it targets: "A1" … "C1"
  level     String
  /// "grammar" | "vocabulary" | "reading" | "listening"
  skill     String
  /// PlacementItemSchema JSON.
  data      Json
  model     String?
  createdAt DateTime @default(now())

  @@index([level, skill])
}

/// One finished placement test.
model PlacementResult {
  id          String   @id @default(cuid())
  /// { grammar: "B1", vocabulary: "A2", reading: …, listening: … }
  levels      Json
  /// [{ questionId, skill, level, picked, correct }] in the order asked.
  answers     Json
  /// Unit the course suggests starting from.
  startUnitId String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
