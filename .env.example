# Copy to .env and keep it out of git.
DATABASE_URL="file:./prisma/dev.db"

# AI feedback, AI examiner and AI-generated sets. Put these in .env.local, never in git.
# AI_PROVIDER: gemini (default) | anthropic (stub) | openai-compatible | mock
# AI_PROVIDER="gemini"
# GEMINI_API_KEY="..."
# AI_MODEL: one model, or a comma-separated list tried in order. Leave it unset to use
# the built-in Gemini list (3.8 → 3.5 Flash, 2.5 Flash, then Flash-Lite models); on the
# free tier each model has its own daily quota, so a longer list lasts longer.
# AI_MODEL="gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash,gemini-3.5-flash-lite"

# Fallback provider(s), tried when every AI_MODEL model is out of quota (429) or overloaded.
# AI_FALLBACK_PROVIDERS="openai-compatible"
# AI_FALLBACK_MODEL="llama-3.3-70b-versatile"   # one model or a list, for the fallback provider

# openai-compatible (main or fallback): any OpenAI-style /chat/completions server.
# AI_BASE_URL="https://api.groq.com/openai/v1"  # OpenRouter: https://openrouter.ai/api/v1, Ollama: http://localhost:11434/v1
# AI_API_KEY="..."                              # not needed for Ollama

# anthropic (adapter is a stub for now):
# ANTHROPIC_API_KEY="sk-ant-..."

# mock: realistic fake answers, no API call and no quota used. Automated tests use it:
#   AI_PROVIDER=mock npm run dev
# AI_MOCK_ERROR="rate_limit"   # or "overloaded": make the mock fail, to test fallbacks

# Optional: require a password (HTTP Basic auth, any user name) for every page.
# Set this before hosting the app anywhere other people can reach.
# APP_PASSWORD="choose-a-long-password"
